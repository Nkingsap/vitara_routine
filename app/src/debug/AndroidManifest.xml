<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug builds only: lets the whole alarm chain be triggered from adb.
         The exact commands are documented in DebugRingReceiver.kt.
         This file is not part of release builds. -->
    <application>
        <receiver
            android:name=".alarm.DebugRingReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vitara.routine.DEBUG_RING" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
