<?xml version="1.0" encoding="utf-8"?>
<!-- Larger frosted glass panel that holds lists -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/glass_fill_soft"
        android:startColor="@color/glass_fill_strong" />
    <corners android:radius="32dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
