<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_ring_gradient"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="28dp"
    android:paddingTop="64dp"
    android:paddingEnd="28dp"
    android:paddingBottom="36dp">

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/ringKicker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@style/CapsLabel"
        tools:text="TIME TO START" />

    <TextView
        android:id="@+id/ringTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/ink_deep"
        android:textSize="34sp"
        android:textStyle="bold"
        tools:text="Wake up" />

    <TextView
        android:id="@+id/ringClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/ink_deep"
        android:textSize="48sp"
        android:textStyle="bold"
        tools:text="4:00 AM" />

    <TextView
        android:id="@+id/ringMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/ink_deep"
        android:textSize="17sp"
        tools:text="Good morning. Get out of bed now." />

    <TextView
        android:id="@+id/ringRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_time_pill"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@color/ink_soft"
        android:textSize="14sp"
        tools:text="4:00 AM – 4:10 AM" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/ringHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:gravity="center"
        android:text="@string/ring_hint"
        android:textColor="@color/ink_soft"
        android:textSize="13sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/snoozeButton"
        style="@style/GlassButton"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginBottom="12dp"
        android:text="@string/snooze"
        android:textSize="16sp"
        app:cornerRadius="29dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dismissButton"
        style="@style/PillButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/dismiss"
        android:textSize="18sp"
        app:cornerRadius="32dp" />

</LinearLayout>
