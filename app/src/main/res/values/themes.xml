<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Liquid glass theme: dark slate actions on a soft mint/teal gradient -->
    <style name="Theme.VitaraRoutine" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/slate</item>
        <item name="colorOnPrimary">@color/on_slate</item>
        <item name="colorPrimaryContainer">@color/glass_fill_strong</item>
        <item name="colorOnPrimaryContainer">@color/ink_deep</item>
        <item name="colorSecondary">@color/frosted_blue</item>
        <item name="colorOnSecondary">@color/ink_on_accent</item>
        <item name="colorSecondaryContainer">@color/icy_aqua</item>
        <item name="colorOnSecondaryContainer">@color/ink_deep</item>
        <item name="colorTertiary">@color/icy_aqua</item>
        <item name="colorOnTertiary">@color/ink_deep</item>
        <item name="colorSurface">@color/mint_cream</item>
        <item name="colorOnSurface">@color/ink_deep</item>
        <item name="colorSurfaceVariant">@color/glass_fill_strong</item>
        <item name="colorOnSurfaceVariant">@color/ink_soft</item>
        <item name="colorOutline">@color/outline_soft</item>
        <item name="android:colorBackground">@color/bg_top</item>
        <item name="android:windowBackground">@drawable/bg_app_background</item>
        <item name="android:statusBarColor">@color/bg_top</item>
        <item name="android:navigationBarColor">@color/bg_bottom</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- Full screen alarm theme -->
    <style name="Theme.VitaraRoutine.Ring" parent="Theme.VitaraRoutine">
        <item name="android:windowBackground">@drawable/bg_ring_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>

    <!-- Uppercase micro labels, e.g. NEXT / TIMETABLE -->
    <style name="CapsLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FieldLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Dark slate pill: the main action on every screen -->
    <style name="PillButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">60dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="backgroundTint">@color/slate</item>
        <item name="android:textColor">@color/on_slate</item>
        <item name="cornerRadius">30dp</item>
        <item name="iconTint">@color/on_slate</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="PillButton.Small">
        <item name="android:layout_height">46dp</item>
        <item name="android:textSize">14sp</item>
        <item name="cornerRadius">23dp</item>
    </style>

    <!-- Translucent glass button -->
    <style name="GlassButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">46dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/glass_fill_strong</item>
        <item name="android:textColor">@color/ink_deep</item>
        <item name="iconTint">@color/ink_deep</item>
        <item name="cornerRadius">23dp</item>
    </style>

    <!-- Time slots in the editor -->
    <style name="TimeSlotButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:layout_height">58dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/glass_fill_strong</item>
        <item name="android:textColor">@color/ink_deep</item>
        <item name="cornerRadius">20dp</item>
    </style>
</resources>
